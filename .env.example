# Django Configuration
DJANGO_SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Supabase PostgreSQL Database Credentials
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=https://your-bankease-frontend.netlify.app,http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=https://your-bankease-frontend.netlify.app,http://localhost:5500,http://127.0.0.1:5500
